# EAS Build ignore — controls what gets uploaded to EAS servers

# Dependencies (installed on server)
node_modules/

# Expo cache
.expo/
dist/
web-build/

# Git
.git/

# Claude Code
.claude/

# Native (generated by prebuild)
/ios
/android

# Credentials & secrets
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
.env
.env.*
!.env.example
.sentryclirc
google-services.json

# Build artifacts
*.tsbuildinfo
.kotlin/
*.orig.*

# OS
.DS_Store
Thumbs.db
nul

# Supabase local
supabase/.temp/

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# Tests (not needed for build)
src/__tests__/
src/__mocks__/
jest.config.js
coverage/

# Docs (not needed for build)
docs/

# Design / CAD sources (not part of the app build)
*.scad

# IDE
.vscode/
.idea/
