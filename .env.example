# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe (client-side only — get from https://dashboard.stripe.com/test/apikeys)
# NEVER put STRIPE_SECRET_KEY in the client .env — it belongs in Supabase Edge Function secrets
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here

# Sentry (get from https://sentry.io → Project Settings → Client Keys)
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn-here

# Environment
EXPO_PUBLIC_ENV=development

# ── Replit note ──
# On Replit, set these as "Secrets" (Tools → Secrets), NOT in a committed .env.
# EXPO_PUBLIC_* vars are read at BUILD time (npm run build:web), so the Secrets
# must exist before the build runs. Keep EXPO_PUBLIC_ENV=development for a
# no-backend preview — in 'production' the app intentionally throws if the
# Supabase vars are missing.
