{
  "name": "littlejourney",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist",
    "serve:web": "node scripts/serve-static.mjs dist",
    "replit": "npm run build:web && npm run serve:web",
    "lint": "eslint src/ --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "tsc --noEmit",
    "verify": "npm run type-check && npm run lint && npm test -- --runInBand",
    "verify:release": "npm run type-check && npm run lint && npm test -- --runInBand && npm run build:web && npm run test:e2e",
    "supabase:prod:check": "npx supabase migration list --linked && npx supabase db lint --linked --fail-on error && npx supabase db advisors --linked --type security --fail-on error && npx supabase db advisors --linked --type performance --level warn --fail-on error",
    "supabase:prod:push:dry-run": "npx supabase db push --linked --dry-run",
    "supabase:prod:push": "npx supabase db push --linked"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^7.14.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/stack": "^7.7.2",
    "@sentry/react-native": "~7.2.0",
    "@stripe/stripe-react-native": "~0.50.3",
    "@supabase/supabase-js": "^2.97.0",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~54.0.33",
    "expo-av": "~16.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-device": "^8.0.10",
    "expo-font": "~14.0.12",
    "expo-image-picker": "^17.0.10",
    "expo-linear-gradient": "^15.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-media-library": "~18.2.1",
    "expo-network": "~8.0.8",
    "expo-notifications": "^0.32.16",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "typescript": "5.9.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@jest/types": "^30.2.0",
    "@playwright/test": "^1.61.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "serve": "^14.2.6",
    "ts-jest": "^29.4.6",
    "typescript-eslint": "^8.62.0"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "private": true
}
